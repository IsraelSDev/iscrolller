# Copie para .env.local e preencha. NUNCA versione .env.local.

# Flag global de conteúdo adulto.
# "false" desliga o toggle na UI e a API nunca devolve itens NSFW.
NSFW_ENABLED=true

# Fotos SFW: chave gratuita em https://www.pexels.com/api/
PEXELS_API_KEY=

# Conteúdo adulto: Eporner API v2 é pública e não exige chave.
