# Copie para .env.local e preencha. NUNCA versione .env.local.

# Flag global de conteúdo adulto.
# "false" desliga o toggle na UI e a API nunca devolve itens NSFW.
NSFW_ENABLED=true

# Fotos SFW: chave gratuita em https://www.pexels.com/api/
PEXELS_API_KEY=

# Conteúdo adulto: Eporner API v2 é pública e não exige chave.

# Feedback dos usuários (JSONL). Padrão: ./data/feedback.jsonl
FEEDBACK_FILE=

# Envio de feedback por email (Resend: https://resend.com, plano gratuito).
# Sem dominio verificado, o Resend so entrega para o email da propria conta Resend.
RESEND_API_KEY=
FEEDBACK_EMAIL_TO=
# Opcional, exige dominio verificado no Resend (ex.: iscrolller <feedback@iscrolller.com>)
FEEDBACK_EMAIL_FROM=
